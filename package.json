    "desktop:dev": "node tools/desktop-dev.mjs",
    "test:desktop": "node tools/desktop-test.mjs",
    "trailer": "node tools/trailer/record.mjs tools/trailer/sample.js --review art/review/trailer-sample",
    "trailer:assemble": "node tools/trailer/assemble.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.51.0",
    "vite": "^6.1.0"
